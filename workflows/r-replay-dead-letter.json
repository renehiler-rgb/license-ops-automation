          "name": "licenseops DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- \"Mark replayed\" and \"Count attempt\" nodes of the replay workflow. Parameters in order: dead_letter_id, replayed (true/false).\n-- A successful replay closes the entry; a failed one stays open and only counts the attempt.\nUPDATE dead_letter\nSET status   = CASE WHEN $2::boolean THEN 'replayed' ELSE status END,\n    attempts = attempts + 1\nWHERE id = $1::int\nRETURNING id, status, attempts;\n",
        "options": {
          "queryReplacement": "={{ [String($('Build replay request').item.json.dead_letter_id), 'true'] }}"
        }
      },
      "name": "Mark replayed",
      "type": "n8n-nodes-base.postgres",
