    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- \"Open embedding failures\" node of the replay workflow. No parameters. Turn on \"Always Output Data\".\n-- One row per open dead_letter entry of workflow C1 whose step was \"Embed chunks\", with the chunks of that\n-- document that still have no embedding (the text was saved, only the search index is missing).\nSELECT dl.id AS dead_letter_id,\n       (dl.payload->>'document_id')::int AS document_id,\n       (SELECT jsonb_agg(jsonb_build_object('chunk_index', c.chunk_index, 'content', c.content) ORDER BY c.chunk_index)\n        FROM contract_chunks c\n        WHERE c.document_id = (dl.payload->>'document_id')::int AND c.embedding IS NULL) AS chunks\nFROM dead_letter dl\nWHERE dl.workflow = 'C1 - Contract intake' AND dl.node = 'Embed chunks' AND dl.status = 'open'\nORDER BY dl.id;\n",
        "options": {}
      },
      "name": "Open embedding failures",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        90
      ],
      "id": "36e43857-a76b-44b7-bd03-785777d10e75",
      "credentials": {
        "postgres": {
          "id": "AhiED7cuq2sS3DZ6",
          "name": "licenseops DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.dead_letter_id !== undefined && $json.dead_letter_id !== null }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Any open?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        90
      ],
      "id": "a3743899-b448-415a-b859-3f47b175b48e"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Code node \"Build replay request\"  (mode: Run Once for Each Item)\n// Input : one open dead_letter row with the chunks that still need an embedding.\n// Output: { dead_letter_id, document_id, indexes, has_chunks, embed_request }.\n// A document with nothing left to embed (someone fixed it by hand) is just closed.\n\nconst row = $json;\nconst chunks = row.chunks ?? [];\nconst cfg = $('Config').first().json.cfg;\n\nreturn {\n  json: {\n    dead_letter_id: row.dead_letter_id,\n    document_id: row.document_id,\n    has_chunks: chunks.length > 0,\n    indexes: chunks.map((c) => c.chunk_index),\n    embed_request: {\n      model: cfg.ollama_embed_model ?? 'nomic-embed-text',\n      input: chunks.map((c) => `search_document: ${c.content}`),\n    },\n  },\n};\n"
      },
      "name": "Build replay request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        30
      ],
      "id": "d08870db-d327-47eb-b635-a95ce56f0d8c"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.has_chunks }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Chunks to embed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        30
      ],
      "id": "eebab1c3-c62c-4b90-a087-687f9718d3f2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.cfg.ollama_url }}/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.embed_request) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Embed again",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -30
      ],
      "id": "76625b20-4607-4d87-a4aa-61843b66186b",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- \"Save replayed embeddings\" node of the replay workflow.\n-- Parameters in order: document_id, embeddings (JSON array of vectors), chunk indexes (JSON array, same order).\n-- Returns ONE row (the number of chunks saved) so the next node runs once per dead_letter entry.\nWITH up AS (\n    UPDATE contract_chunks c\n    SET embedding = (e.vec)::text::vector\n    FROM jsonb_array_elements($2::jsonb) WITH ORDINALITY AS e(vec, n)\n    JOIN jsonb_array_elements_text($3::jsonb) WITH ORDINALITY AS i(chunk_index, m) ON m = n\n    WHERE c.document_id = $1::int AND c.chunk_index = i.chunk_index::int\n    RETURNING c.chunk_index\n)\nSELECT count(*) AS saved FROM up;\n",
        "options": {
          "queryReplacement": "={{ [String($('Build replay request').item.json.document_id), JSON.stringify($json.embeddings), JSON.stringify($('Build replay request').item.json.indexes)] }}"
        }
      },
      "name": "Save replayed embeddings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1760,
        -90
      ],
      "id": "22cefdd9-e217-45c2-a09d-9e749be3b6ef",
      "credentials": {
