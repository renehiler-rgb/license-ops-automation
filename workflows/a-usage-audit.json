    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- One row per failed fetch and execution; a re-run of the same execution does not add another.\nINSERT INTO dead_letter (workflow, node, payload, error)\nSELECT 'A - Usage audit', $1, $2::jsonb, $3\nWHERE NOT EXISTS (\n    SELECT 1 FROM dead_letter\n    WHERE workflow = 'A - Usage audit' AND node = $1 AND status = 'open'\n      AND payload->>'execution_id' = $4\n);",
        "options": {
          "queryReplacement": "={{ [ $prevNode.name, JSON.stringify({ execution_id: String($execution.id), http_status: $json.error?.httpCode ?? $json.error?.response?.status ?? null }), String($json.error?.message ?? $json.error ?? 'unknown error'), String($execution.id) ] }}"
        }
      },
      "name": "Insert dead_letter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
