# Copy to .env and fill in. Never commit .env.

# n8n: copy the value from ~/n8n/.env (must match the existing volume)
N8N_ENCRYPTION_KEY=replace-with-existing-key

# Postgres password for the licenseops user
POSTGRES_PASSWORD=change-me

# Fraction of mock-vendor requests that fail on purpose (0 to 1).
# 0 gives a clean first sync. Set 0.05 (or higher) and run `docker compose up -d mock-vendors` to see retries,
# partial-vendor digests and failure alerts (docs/failure-testing.md).
CHAOS_RATE=0

# Mock vendor APIs: any values work, they only need to match what you enter in n8n
HR_API_KEY=change-me
CHATTERLY_API_KEY=change-me
DESIGNHUB_API_KEY=change-me
CODEFORGE_CLIENT_ID=change-me
CODEFORGE_CLIENT_SECRET=change-me
MEETSPACE_CLIENT_ID=change-me
MEETSPACE_CLIENT_SECRET=change-me

# Contract intake webhook (workflow C1): any long random string; scripts/post_contract.sh sends it as X-Intake-Key
INTAKE_API_KEY=change-me

# OPTIONAL. Only needed if you switch app_config.llm_provider to "anthropic" (contract extraction and Q&A).
# The default is "ollama": everything runs locally and no key is needed.
# ANTHROPIC_API_KEY=

# REQUIRED. Slack bot token (xoxb-...). How to get it: docs/slack-setup.md
SLACK_BOT_TOKEN=change-me

# Ports on 127.0.0.1 (change them to run a second copy next to this one)
# HOST_N8N_PORT=5678
# HOST_POSTGRES_PORT=5432
# HOST_MOCK_PORT=8000

# Owner account for n8n, created by scripts/bootstrap.sh on a fresh install (the password is generated if left empty)
N8N_OWNER_EMAIL=owner@northwind.example
N8N_OWNER_PASSWORD=

# OPTIONAL. Jira for renewal tickets (workflow D). Leave empty to keep Jira off.
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_DOMAIN=yourcompany.atlassian.net
